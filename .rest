
@local = http://localhost:8080
@render = https://YOUR-APP.onrender.com

### LOCAL - Get All Items
GET {{local}}/api/items

### LOCAL - Get All Locations
GET {{local}}/api/locations

### LOCAL - Create Location
POST {{local}}/api/locations
Content-Type: application/json

{
    "name": "Desk",
    "room": "Office",
    "notes": null
}

### RENDER - Get All Items
GET {{render}}/api/items

### RENDER - Get All Locations
GET {{render}}/api/locations

### RENDER - Create Location
POST {{render}}/api/locations
Content-Type: application/json

{
    "name": "Garage Shelf",
    "room": "Garage",
    "notes": null
}
